ANTHROPIC_API_KEY=sk-ant-...
# Answer model. Any current Claude model works; Sonnet is the default.
RAG_LLM_MODEL=claude-sonnet-5-5
# Cheaper/faster model used only to rewrite follow-up questions.
RAG_REWRITE_MODEL=claude-haiku-5-5
# sentence-transformers (default, real semantic search) or hashing (offline fallback, lexical only)
RAG_EMBEDDING_BACKEND=sentence-transformers
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Relevance gate (cosine). Calibrate with: python -m evaluation.run_eval --calibrate
# RAG_MIN_RELEVANCE=0.60
