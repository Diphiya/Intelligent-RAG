digraph RAG {
  rankdir=TB; fontname="Helvetica"; nodesep=0.35; ranksep=0.5; compound=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#ffffff", color="#5c6b8a"];
  edge [fontname="Helvetica", fontsize=9, color="#5c6b8a"];

  user [label="User\n(web UI / API client)", shape=oval, fillcolor="#e7f0ff"];

  subgraph cluster_ing { label="A. Ingestion  (POST /documents)"; style="rounded,filled"; fillcolor="#f4f8ff"; color="#9db4e0"; fontname="Helvetica-Bold";
    up   [label="Upload validation\nPDF/TXT only, size limit,\nmagic bytes"];
    ext  [label="Text extraction\npypdf per page / TXT decode\n(scanned PDF -> clear error)"];
    pre  [label="Preprocessing\nNFKC, de-hyphenate, unwrap lines,\nstrip headers/footers"];
    dup  [label="Document de-dup\nhash of normalised text", fillcolor="#fff4e6"];
    chk  [label="Chunking\nrecursive 400 chars / 66 overlap\nnever crosses pages"];
    emb  [label="Embedding\nbge-small-en-v1.5 (local)\n+ title header"];
  }

  store [label="Vector store\nFAISS IndexFlatIP (cosine)\n+ chunk/doc registry on disk", shape=cylinder, fillcolor="#e6fcf5", color="#2b8a3e"];
  bm25  [label="BM25 inverted index\n(rebuilt when store changes)", shape=cylinder, fillcolor="#e6fcf5", color="#2b8a3e"];

  subgraph cluster_q { label="B. Question answering  (POST /ask)"; style="rounded,filled"; fillcolor="#fff9f0"; color="#e0b27d"; fontname="Helvetica-Bold";
    mem  [label="Conversation memory\nlast 6 turns / session"];
    rw   [label="Query rewriting\nClaude Haiku -> standalone question\n(heuristic fallback)"];
    ret  [label="Hybrid retrieval\ndense top-20 + BM25 top-20\n-> RRF fusion"];
    gate [label="Relevance gate\nbest cosine >= 0.60 ?", shape=diamond, fillcolor="#fff4e6"];
    dd   [label="Near-duplicate collapse\n(only if numbers equal)\n+ conflict hints"];
    gen  [label="Grounded generation\nClaude Sonnet, strict tool schema\npassages <S1..Sn>, injection-safe"];
    ver  [label="Post-verification\ncitations exist? numbers in sources?\nschema valid? (1 retry)", fillcolor="#fff4e6"];
    nf   [label="Abstain: 'not found in documents'\n(no LLM call)", fillcolor="#ffe3e3", color="#c92a2a"];
  }
  resp [label="Structured response\nanswer, citations(page, snippet),\nconfidence, conflict flag,\nwarnings, retrieval diagnostics", fillcolor="#e7f0ff", shape=note];

  user -> up [label="files"];
  up -> ext -> pre -> dup -> chk -> emb -> store;
  dup -> user [style=dashed, label="duplicate: skipped", constraint=false];
  chk -> bm25 [style=dashed, constraint=false];

  user -> mem [label="question"];
  mem -> rw -> ret;
  store -> ret [label="vectors"];
  bm25 -> ret;
  ret -> gate -> dd [label="pass"];
  gate -> nf [label="fail"];
  dd -> gen -> ver -> resp;
  nf -> resp;
  resp -> user;
  resp -> mem [style=dashed, label="save turn", constraint=false];
}
